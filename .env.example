# Server-side only. Do not use the NEXT_PUBLIC_ prefix.
# Production values (ingress api.rupira.com → hrupira / whrupira):
#   HR        : hrupira  GET /hr/v1/signature/approver/:id         (public)
#   Warehouse : whrupira GET /warehouse/v1/signatures/public/:id   (public)
SIGNATURE_API_URL=https://api.rupira.com/hr/v1/signature/approver
SIGNATURE_WAREHOUSE_API_URL=https://api.rupira.com/warehouse/v1/signatures/public

# Deprecated fallbacks (still read if the names above are unset):
# NEXT_PUBLIC_SIGNATURE_API_URL=
# NEXT_PUBLIC_SIGNATURE_WAREHOUSE_API_URL=
